+/** Resolve the exact Persian/Arabic/Tajik equivalent of a translated article. */
+function navar_article_translation_url( $post_id, $lang ) {
+    $post_id = absint($post_id);
+    $lang = in_array($lang, array('fa','iraq','tj'), true) ? $lang : 'fa';
+    $post = $post_id ? get_post($post_id) : false;
+    if ( ! $post || 'post' !== $post->post_type ) return '';
+    $current_language = (string) get_post_meta($post_id, '_navar_translation_language', true);
+    $source_id = absint(get_post_meta($post_id, '_navar_translation_source_id', true));
+    if ( ! $source_id ) $source_id = $post_id;
+    if ( 'fa' === $lang ) return get_post_status($source_id) === 'publish' ? get_permalink($source_id) : '';
+    $wanted = 'iraq' === $lang ? 'ar-IQ' : 'tg-TJ';
+    if ( $current_language === $wanted ) return get_permalink($post_id);
+    $matches = get_posts(array(
+        'post_type'=>'post','post_status'=>'publish','posts_per_page'=>1,'fields'=>'ids',
+        'no_found_rows'=>true,'ignore_sticky_posts'=>true,'suppress_filters'=>false,
+        'meta_query'=>array('relation'=>'AND',
+            array('key'=>'_navar_translation_source_id','value'=>(string)$source_id,'compare'=>'='),
+            array('key'=>'_navar_translation_language','value'=>$wanted,'compare'=>'='),
+        ),
+    ));
+    return ! empty($matches) ? get_permalink(absint($matches[0])) : '';
+}
