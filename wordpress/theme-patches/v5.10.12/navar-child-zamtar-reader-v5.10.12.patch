+function navar_language_post_query_args() {
+    $lang = navar_lang();
+    if ( 'iraq' === $lang ) return array('meta_query'=>array(array('key'=>'_navar_translation_language','value'=>'ar-IQ','compare'=>'=')));
+    if ( 'tj' === $lang ) return array('meta_query'=>array(array('key'=>'_navar_translation_language','value'=>'tg-TJ','compare'=>'=')));
+    return array('meta_query'=>array('relation'=>'OR',
+        array('key'=>'_navar_translation_language','compare'=>'NOT EXISTS'),
+        array('key'=>'_navar_translation_language','value'=>array('ar-IQ','tg-TJ'),'compare'=>'NOT IN'),
+    ));
+}
